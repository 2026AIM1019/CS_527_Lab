1 x1 = 0      % index
1 x2 = [0]    % N
1 x3 = 4      % input address
1 x4 = 16     % output address
1 x8 = 0      % previous sample x[n-1]
1 x9 = 0      % previous-previous sample x[n-2]
4 x5 = x1 - x2
4 BEQ .exit
3 x6 = [x3]   % current sample
3 x7 = x6 * 1
3 x10 = x8 * 2
3 x11 = x9 * 1
3 x12 = x7 + x10
3 x12 = x12 + x11
3 [x4] = x12
3 x9 = x8 + 0
3 x8 = x6 + 0
3 x3 = x3 + 4
3 x4 = x4 + 4
3 x1 = x1 + 1
3 BAL .loop
